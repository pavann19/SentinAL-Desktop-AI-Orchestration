# SentinAL v9.0 — Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
SENTINAL_PORT=8000
SENTINAL_UI_PORT=5173
# SECURITY: keep this on loopback. /api/command executes real OS actions, so
# binding 0.0.0.0 publishes command execution to every network interface.
SENTINAL_HOST=127.0.0.1

# ── API Authentication ────────────────────────────────────────────────────────
# Bearer token required by /api/command and /api/logs. If left unset, a random
# token is generated at first startup and written to .sentinal_token
# (gitignored). Set it explicitly for deployments or multi-process setups.
SENTINAL_API_TOKEN=

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set to "groq" for cloud or "local" for Ollama only
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=llama3.2:latest
OLLAMA_VISION_MODEL=llama3.2-vision

# ── Voice Services ────────────────────────────────────────────────────────────
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key_here
PICOVOICE_ACCESS_KEY=your_picovoice_key_here

# ── Web Search ────────────────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_MAX_RESULTS=3

# ── Tuning & Limits ───────────────────────────────────────────────────────────
TASK_QUEUE_MAX=20
SESSION_TIMEOUT=15.0
NLP_CORRECTION_TIMEOUT=3.0
EXECUTOR_STEP_DELAY=0.1
GUI_FOCUS_WAIT=1.0

# ── Debug ─────────────────────────────────────────────────────────────────────
# Set to "true" ONLY in development to enable Ghost Protocol / diagnostic bypass
SENTINAL_DEBUG=false
