.env
__pycache__/
venv/
logs/
.pytest_cache/
node_modules/
# Runtime data directory (config.paths.DATA_DIR): local DBs, downloaded voice
# models, and timestamped artifacts generated by DataModelingIntent /
# AcademicResearchIntent (SentinAL_EDA_*.png, SentinAL_Summary_*.txt). Nothing
# under here has ever been tracked — replaces the narrower per-file entries
# this line used to be, which missed the generated-artifact filenames.
data/
memory/*.db
.coverage
htmlcov/
sentinal-ui/dist/
sentinal-ui/build/
sentinal-ui/release/
_backups/

# Generated evaluation/model artifacts are local evidence, not public-repo content.
_evidence/**
!_evidence/
!_evidence/.gitkeep
eval/intent_eval_results.json

# Local API auth token (generated at runtime, never commit)
.sentinal_token

docs/reports/CODEBASE_ANALYSIS.md
docs/reports/

# Python distribution and CI report outputs
/build/
/dist/
*.egg-info/
coverage.xml
test-results/
